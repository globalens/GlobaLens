# Response headers for the static export (master plan §9; design note §9 task 12, §15).
# Cloudflare Workers Static Assets reads this file; its limits there are a setup question.
#
# The policy that governs scripts is a <meta> tag in each page, written with the page's
# inline-script hashes after the export (design note Q21). A <meta> policy cannot carry
# frame-ancestors or a report-only policy, so those two are here. Trusted Types is
# report-only in P1 and enforced from P2.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  Content-Security-Policy-Report-Only: require-trusted-types-for 'script'; trusted-types globalens-worker-url

# Hashed build output never changes under its name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The first-paint globes keep their names from build to build.
/globe/*
  Cache-Control: public, max-age=86400
